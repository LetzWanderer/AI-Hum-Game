@@ -0,0 +1,132 @@
+{
+  "en": {
+    "fl-1c": "Hotline backlogs leave people waiting for help.",
+    "os-1b": "Waiting for confirmation delays the response to a possible outbreak.",
+    "cn-1c": "Manual note-taking leaves less time for care and longer waiting lists.",
+    "fl-4c": "Harmful replies persist, and unsupported volunteers burn out.",
+    "tu-1b": "Fresh field data includes overlooked households, despite the delay.",
+    "tu-1c": "Misleading proxies misclassify households and delay corrections.",
+    "tu-2a": "Known bias leaves vulnerable households without timely assistance.",
+    "tu-2b": "Community review corrects exclusions and reduces disputes, despite the delay.",
+    "tu-3c": "Three months of development delay assistance; autonomy is scored separately.",
+    "tu-4b": "Full verification delays cash while hunger worsens.",
+    "fo-1a": "Satellite blind spots leave urgent needs uncounted.",
+    "fo-2b": "Hosting negotiations delay response capacity; autonomy is scored separately.",
+    "fo-2c": "A month of setup stretches the team and slows the response.",
+    "cq-1c": "Four extra months and diverted funds constrain service delivery.",
+    "cq-4c": "A long transition and degraded features constrain services.",
+    "en-1a": "The tool fails at field sites and consumes scarce resources.",
+    "en-1c": "Translation and case-note backlogs leave volunteers without timely support.",
+    "os-2a": "Mis-ranked patients wait until they collapse, despite faster throughput.",
+    "os-3c": "Withholding all data weakens preparation for the next outbreak.",
+    "bt-1a": "Ungoverned pilots expose data and divert capacity into duplicate tools.",
+    "ie-1c": "Late payments harm small suppliers and volunteers advancing their own money.",
+    "ie-3c": "Extra maintenance and peak-time slowdowns constrain payment capacity.",
+    "vr-1c": "Essential early-morning distribution shifts remain uncovered.",
+    "hw-1c": "Cold starts miss the first and deadliest hours of a heat alert."
+  },
+  "sv": {
+    "fl-1c": "Köer till hjälplinjen gör att människor får vänta på hjälp.",
+    "os-1b": "Att invänta bekräftelse fördröjer insatser vid ett möjligt utbrott.",
+    "cn-1c": "Manuell journalföring ger mindre tid för vård och längre väntelistor.",
+    "fl-4c": "Skadliga svar blir kvar och volontärer utan stöd blir utmattade.",
+    "tu-1b": "Nya fältdata inkluderar förbisedda hushåll, trots fördröjningen.",
