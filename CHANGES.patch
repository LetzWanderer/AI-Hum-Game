+.step-art { display: block; width: 100%; max-width: 320px; height: auto; margin: 0 auto 12px; border-radius: var(--radius); }
+.playgrid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
+.playgrid.active-decision { gap: 12px; }
+.status { position: static; order: -1; display: grid; gap: 8px 24px; align-items: center; }
+.status .radar { display: block; width: 100%; max-width: 420px; margin: 0 auto; }
+
+/* Responsive layouts; no historical layout overrides. */
+@media (min-width: 720px) {
+  .status { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
+  .status > .label { grid-column: 2; grid-row: 1; margin-top: 0 !important; text-align: center; }
+  .status > .srow { grid-column: 1; grid-row: 1 / span 2; }
+  .status > .radar-chart { grid-column: 2; grid-row: 2; }
+}
+@media (min-width: 640px) {
+  .grid.two { grid-template-columns: 1fr 1fr; }
+  .modebtns { grid-template-columns: 1fr 1fr; }
+  .status .radar { max-width: 280px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  * { transition: none !important; }
+  .cover.leaving { transform: none; }
+  .enter-in main { animation: none; }
+  #app.swap main { animation: none; }
+}
+@media (min-width: 768px) {
+  main.wrap.pad { max-width: 1120px; }
+  main.wrap.pad:has(.active-decision) { padding-top: 12px; }
+  main.wrap.pad:has(.active-decision) > .playgrid { margin-top: 12px; }
+  .decision-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .active-decision .scene { padding: 12px 16px; }
+  .choice-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .active-decision .choice-grid .letter { width: 28px; height: 28px; font-size: 14px; }
+  .active-decision .choice-grid .opt { flex-direction: row; gap: 8px; }
+  .scene:has(.step-art) { display: grid; grid-template-columns: 240px minmax(0,1fr); column-gap: 24px; grid-template-rows: auto 1fr; align-items: start; }
+  .scene .step-art { grid-row: span 2; margin: 0; }
+}
+@media (max-width: 639px) {
+  .wrap { padding: 0 14px; }
+  .modes, .modebtns, .grid.two { grid-template-columns: 1fr; }
+  .hero { padding-top: 28px; padding-bottom: 44px; }
+  .rowhead { flex-wrap: wrap; gap: 4px; }
+  .bar .wrap { flex-wrap: wrap; }
+  .back { text-align: start; }
+  select { max-width: 100%; }
+  [data-topic] { width: 100%; margin-top: 6px; }
+  .box, .banner { padding: 14px; }
+  .playbox { padding: 28px 20px; }
+  #app {
+  --heading-h1: 26px;
+  --heading-h2: 22px;
+  --heading-cover: 34px;
+}
+  .choices-heading .timer { width: 100%; }
+  .snapshot { gap: 12px; }
+}
